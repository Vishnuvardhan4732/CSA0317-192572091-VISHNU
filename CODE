class DashboardService:
    def __init__(self, db):
        self.db = db

    def stats(self, user):
        conn = self.db.connect()
        q = conn.execute("SELECT COUNT(*) FROM questions").fetchone()[0]
        e = conn.execute("SELECT COUNT(*) FROM exams").fetchone()[0]
        if user["role"] == "student":
            r, avg = conn.execute("SELECT COUNT(*), AVG(percentage) FROM results WHERE username=?",
                                  (user["username"],)).fetchone()
            tiles = {"📚 Questions": q, "📝 Exams": e, "✅ My Results": r, "📈 Avg Score": f"{round(avg or 0, 1)}%"}
        else:
            r = conn.execute("SELECT COUNT(*) FROM results").fetchone()[0]
            u = conn.execute("SELECT COUNT(*) FROM users").fetchone()[0]
            tiles = {"📚 Questions": q, "📝 Exams": e, "✅ Results": r, "👥 Users": u}
        conn.close()
        return tiles

    def notifications(self, user):
        notes = []
        conn = self.db.connect()
        now = now_str()
        for title, start, end in conn.execute("SELECT title, start_time, COALESCE(end_time, '') FROM exams "
                                              "ORDER BY start_time"):
            if end and now > end:
                continue                                       # closed exams are not announced
            notes.append(f"{'🟢 Live now' if start <= now else '🕒 Upcoming'}:  {title}  ({start}"
                         + (f"  →  {end}" if end else "") + ")")
        conn.close()
        return notes or ["No exams scheduled."]


