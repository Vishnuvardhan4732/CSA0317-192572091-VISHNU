# MODULE 1: Login Module (authentication, roles, sessions, profile, users)
# ============================================================
class AuthManager:
    def __init__(self, db, audit):
        self.db = db
        self.audit = audit
        self.current_user = None          # dict: username, role, full_name
        self.last_activity = time.time()
        self.last_error = ""
        self.failed = {}                  # username -> consecutive wrong passwords (hash map)
        self.locked_until = {}            # username -> unix time when the lock ends
        self._seed_users()

    # ---------- password protection (salted PBKDF2 hash) ----------
    @staticmethod
    def _hash(password, salt):
        return hashlib.pbkdf2_hmac("sha256", password.encode(), salt, 100_000).hex()

    def register(self, username, password, role, full_name=""):
        if not username or not password or role not in ROLE_COLORS:
            raise ValueError("Username, password and a valid role are required")
        salt = os.urandom(16)
        conn = self.db.connect()
        conn.execute("""INSERT INTO users (username, password_hash, salt, role, full_name)
                        VALUES (?, ?, ?, ?, ?)
                        ON CONFLICT(username) DO UPDATE SET password_hash=excluded.password_hash,
                        salt=excluded.salt, role=excluded.role, full_name=excluded.full_name""",
                     (username, self._hash(password, salt), salt.hex(), role, full_name))
        conn.commit()
        conn.close()

    def _seed_users(self):
        conn = self.db.connect()
        count = conn.execute("SELECT COUNT(*) FROM users").fetchone()[0]
        conn.close()
        if count == 0:
            self.register("admin", "admin123", "admin", "System Administrator")
            self.register("teacher", "teacher123", "teacher", "Demo Teacher")
            self.register("student", "student123", "student", "Demo Student")

    def _check(self, username, password):
        conn = self.db.connect()
        row = conn.execute("SELECT password_hash, salt, role, full_name FROM users WHERE username=?",
                           (username,)).fetchone()
        conn.close()
        if not row:
            return None
        stored, salt, role, full_name = row
        if hmac.compare_digest(stored, self._hash(password, bytes.fromhex(salt))):
            return role, full_name
        return None

    def login(self, username, password):
        self.last_error = ""
        remaining = self.locked_until.get(username, 0) - time.time()
        if remaining > 0:
            self.last_error = f"Too many failed attempts. Try again in {int(remaining) + 1} seconds."
            self.audit.log("LOGIN_BLOCKED", "account is locked", actor=username or "unknown")
            return False
        found = self._check(username, password)
        if found:
            role, full_name = found
            self.failed.pop(username, None)
            self.current_user = {"username": username, "role": role, "full_name": full_name or username}
            self.touch()
            self.audit.actor = username
            self.audit.log("LOGIN", f"role={role}")
            return True
        count = self.failed.get(username, 0) + 1
        self.failed[username] = count
        if count >= MAX_FAILED_LOGINS:
            self.locked_until[username] = time.time() + LOCK_SECONDS
            self.failed[username] = 0
            self.last_error = f"Too many failed attempts. Account locked for {LOCK_SECONDS} seconds."
        else:
            self.last_error = f"Invalid username or password.  ({MAX_FAILED_LOGINS - count} attempt(s) left)"
        self.audit.log("LOGIN_FAILED", "wrong username or password", actor=username or "unknown")
        return False

    def logout(self):
        if self.current_user:
            self.audit.log("LOGOUT")
        self.current_user = None
        self.audit.actor = "system"

    def change_password(self, old, new):
        user = self.current_user["username"]
        if not self._check(user, old):
            raise ValueError("Current password is incorrect")
        if len(new) < 6:
            raise ValueError("New password must be at least 6 characters")
        self.register(user, new, self.current_user["role"], self.current_user["full_name"])
        self.audit.log("PASSWORD_CHANGED")

    # ---------- profile management ----------
    def get_profile(self):
        u = self.current_user
        conn = self.db.connect()
        row = conn.execute("SELECT full_name, email, phone, department FROM users WHERE username=?",
                           (u["username"],)).fetchone()
        conn.close()
        return {"username": u["username"], "role": u["role"], "full_name": row[0] or "",
                "email": row[1] or "", "phone": row[2] or "", "department": row[3] or ""}

    def update_profile(self, full_name, email, phone, department):
        full_name, email, phone, department = (x.strip() for x in (full_name, email, phone, department))
        if not full_name:
            raise ValueError("Full name is required")
        if email and not re.match(r"^[^@\s]+@[^@\s]+\.[^@\s]+$", email):
            raise ValueError("Please enter a valid email address")
        if phone and not re.match(r"^[0-9+\-\s]{7,15}$", phone):
            raise ValueError("Phone must be 7-15 digits (you may use + - and spaces)")
        conn = self.db.connect()
        conn.execute("UPDATE users SET full_name=?, email=?, phone=?, department=? WHERE username=?",
                     (full_name, email, phone, department, self.current_user["username"]))
        conn.commit()
        conn.close()
        self.current_user["full_name"] = full_name
        self.audit.log("PROFILE_UPDATED")

    # ---------- user management (admin) ----------
    def list_users(self):
        conn = self.db.connect()
        rows = conn.execute("SELECT username, full_name, role, email, department FROM users "
                            "ORDER BY role, username").fetchall()
        conn.close()
        return rows

    def add_user(self, username, password, role, full_name=""):
        username = username.strip()
        if not re.fullmatch(r"[A-Za-z0-9_.\-]{3,30}", username):
            raise ValueError("Username must be 3-30 characters: letters, digits, . _ or -")
        if len(password) < 6:
            raise ValueError("Password must be at least 6 characters")
        if role not in ROLE_COLORS:
            raise ValueError("Role must be student, teacher or admin")
        conn = self.db.connect()
        exists = conn.execute("SELECT 1 FROM users WHERE username=?", (username,)).fetchone()
        conn.close()
        if exists:
            raise ValueError(f"Username '{username}' already exists")
        self.register(username, password, role, full_name.strip())
        self.audit.log("USER_ADDED", f"{username} ({role})")

    def update_user(self, username, full_name, role, new_password=""):
        """Admin: change a user's name / role and optionally reset the password."""
        if not self.has_role("admin"):
            raise ValueError("Only administrators can edit users")
        if role not in ROLE_COLORS:
            raise ValueError("Role must be student, teacher or admin")
        if new_password and len(new_password) < 6:
            raise ValueError("New password must be at least 6 characters")
        conn = self.db.connect()
        row = conn.execute("SELECT role FROM users WHERE username=?", (username,)).fetchone()
        if not row:
            conn.close()
            raise ValueError("User not found")
        if row[0] != role:
            if username == self.current_user["username"]:
                conn.close()
                raise ValueError("You cannot change your own role")
            if row[0] == "admin" and conn.execute("SELECT COUNT(*) FROM users WHERE role='admin'").fetchone()[0] <= 1:
                conn.close()
                raise ValueError("Cannot remove the last administrator")
        conn.execute("UPDATE users SET full_name=?, role=? WHERE username=?", (full_name.strip(), role, username))
        if new_password:
            salt = os.urandom(16)
            conn.execute("UPDATE users SET password_hash=?, salt=? WHERE username=?",
                         (self._hash(new_password, salt), salt.hex(), username))
        conn.commit()
        conn.close()
        self.audit.log("USER_EDITED", f"{username}" + (" (password reset)" if new_password else ""))

    def delete_user(self, username):
        if self.current_user and username == self.current_user["username"]:
            raise ValueError("You cannot delete your own account")
        conn = self.db.connect()
        row = conn.execute("SELECT role FROM users WHERE username=?", (username,)).fetchone()
        if row and row[0] == "admin":
            admins = conn.execute("SELECT COUNT(*) FROM users WHERE role='admin'").fetchone()[0]
            if admins <= 1:
                conn.close()
                raise ValueError("Cannot delete the last administrator")
        conn.execute("DELETE FROM users WHERE username=?", (username,))
        conn.commit()
        conn.close()
        self.audit.log("USER_DELETED", username)

    def bulk_add_users(self, text, default_role="student"):
        """One user per line: username | password | full name [| role]  (tabs or commas also work).
        Returns (added_count, [error messages])."""
        added, errors = 0, []
        for n, raw in enumerate(text.splitlines(), start=1):
            line = raw.strip()
            if not line:
                continue
            sep = "|" if "|" in line else "\t" if "\t" in line else ","
            parts = [p.strip() for p in line.split(sep)]
            if len(parts) < 2:
                errors.append(f"Line {n}: need at least 'username | password'")
                continue
            role = parts[3].lower() if len(parts) > 3 and parts[3] else default_role
            try:
                self.add_user(parts[0], parts[1], role, parts[2] if len(parts) > 2 else "")
                added += 1
            except ValueError as e:
                errors.append(f"Line {n}: {e}")
        return added, errors

    # ---------- session ----------
    def touch(self):
        self.last_activity = time.time()

    def session_expired(self):
        return self.current_user is not None and time.time() - self.last_activity > INACTIVITY_SECONDS

    def has_role(self, *roles):
        return self.current_user is not None and self.current_user["role"] in roles


