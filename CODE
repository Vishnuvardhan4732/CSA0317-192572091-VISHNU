        try:
            self.controller.auth.update_profile(*(self.vars[k].get() for k in
                                                   ("full_name", "email", "phone", "department")))
            messagebox.showinfo("Saved", "Profile updated successfully.")
            self.on_show()
        except ValueError as e:
            messagebox.showerror("Invalid Data", str(e))

    def change_password(self):
        v = {k: x.get() for k, x in self.pvars.items()}
        try:
            if v["new"] != v["confirm"]:
                raise ValueError("New password and confirmation do not match")
            self.controller.auth.change_password(v["old"], v["new"])
            messagebox.showinfo("Success", "Password updated.")
            self.on_show()
        except ValueError as e:
            messagebox.showerror("Error", str(e))


