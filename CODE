            items = [("Questions in bank", len(self.controller.qbank.search()), C_BLUE),
                     ("Exams scheduled", len(self.controller.exams.list_exams()), C_ORANGE),
                     ("Results stored", len(self.controller.results.list_results()), C_GREEN)]
