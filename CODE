# MODULE 5: Automatic Result Generation Module (+ analytics queries)
# ============================================================
class ResultGenerator:
    GRADES = [(90, "A+"), (80, "A"), (70, "B"), (60, "C"), (50, "D"), (0, "F")]

    def __init__(self, db, audit):
        self.db = db
        self.audit = audit

    def grade_for(self, pct):
        for cutoff, g in self.GRADES:
            if pct >= cutoff:
                return g

    @staticmethod
    def _option_text(q, letter):
        return f"{letter}. {q.get('option_' + letter.lower(), '')}"

    def grade_question(self, q, given, negative=0.0):
        """Returns (marks_awarded, status, given_text, correct_text)."""
        given = str(given or "").strip()
        marks, qtype = q["marks"], q["qtype"]
        if qtype == "MCQ":
            correct_text = self._option_text(q, q["answer"])
            given_text = self._option_text(q, given.upper()) if given else "-"
        elif qtype == "TrueFalse":
            correct_text, given_text = q["answer"], given or "-"
        else:
            correct_text, given_text = "Keywords: " + q["answer"], (given[:300] or "-")
        if not given:
            return 0, "Unanswered", given_text, correct_text
        if qtype in ("MCQ", "TrueFalse"):
            if given.lower() == q["answer"].lower():
                return marks, "Correct", given_text, correct_text
            return -round(marks * negative, 2), "Wrong", given_text, correct_text
        # Descriptive: keyword matching, proportional marks
        keywords = [k.strip().lower() for k in q["answer"].split(",") if k.strip()]
        hits = sum(1 for k in keywords if k in given.lower())
        awarded = round(marks * hits / len(keywords), 2) if keywords else 0
        status = "Correct" if keywords and hits == len(keywords) else "Partial" if hits else "Wrong"
        return awarded, status, given_text, correct_text

    def evaluate_and_store(self, session, auto_submitted=False):
        negative = float(session.exam.get("negative_marking") or 0)
        details, score = [], 0.0
        for q in session.questions:
            awarded, status, given_text, correct_text = self.grade_question(q, session.answers.get(q["id"]), negative)
            score += awarded
            details.append((q["id"], q["qtype"], q["text"], given_text, correct_text, awarded, q["marks"], status))
        score = round(max(0.0, score), 2)
        total = sum(q["marks"] for q in session.questions)
        pct = round(score / total * 100, 2) if total else 0
        grade = self.grade_for(pct)
        passed = int(pct >= float(session.exam.get("pass_percent") or 50))
        correct = sum(1 for d in details if d[7] == "Correct")
        unanswered = sum(1 for d in details if d[7] == "Unanswered")
        wrong = len(details) - correct - unanswered
        conn = self.db.connect()
        cur = conn.execute("""INSERT INTO results
            (username, exam_id, exam_title, score, total, percentage, grade, auto_submitted,
             correct_count, wrong_count, unanswered, time_taken_sec, warnings, passed)
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
            (session.username, session.exam["id"], session.exam["title"], score, total, pct, grade,
             int(auto_submitted), correct, wrong, unanswered, session.elapsed_seconds(), session.warnings, passed))
        rid = cur.lastrowid
        conn.executemany("""INSERT INTO answers (result_id, question_id, qtype, question_text, given, correct,
                            awarded, max_marks, status) VALUES (?,?,?,?,?,?,?,?,?)""",
                         [(rid,) + d for d in details])
        conn.commit()
        conn.close()
        self.audit.log("EXAM_SUBMITTED", f"{session.exam['title']}: {score}/{total} ({pct}%)"
                       + (" [auto]" if auto_submitted else ""), actor=session.username)
        return self.get(rid)

    def get(self, rid):
        conn = self.db.connect()
        conn.row_factory = sqlite3.Row
        row = conn.execute("SELECT * FROM results WHERE id=?", (rid,)).fetchone()
        conn.close()
        return dict(row) if row else None

    def details(self, rid):
        conn = self.db.connect()
        conn.row_factory = sqlite3.Row
        rows = [dict(r) for r in conn.execute("SELECT * FROM answers WHERE result_id=? ORDER BY id", (rid,))]
        conn.close()
        return rows

    def list_results(self, username=None):
        conn = self.db.connect()
        conn.row_factory = sqlite3.Row
        if username:
            rows = conn.execute("SELECT * FROM results WHERE username=? ORDER BY id DESC", (username,))
        else:
            rows = conn.execute("SELECT * FROM results ORDER BY id DESC")
        out = [dict(r) for r in rows]
        conn.close()
        return out

    def user_summary(self, username):
        rows = self.list_results(username)
        if not rows:
            return {"count": 0, "average": 0, "best": 0}
        pcts = [r["percentage"] for r in rows]
        return {"count": len(rows), "average": round(sum(pcts) / len(pcts), 1), "best": max(pcts)}

    def leaderboard(self, n=5, username=None):
        """Top-n using a heap (optionally only one student's own results)."""
        return heapq.nlargest(n, self.list_results(username), key=lambda r: r["percentage"])

    # ---------- analytics ----------
    def overall_stats(self):
        conn = self.db.connect()
        attempts, avg, passed, best = conn.execute(
            "SELECT COUNT(*), AVG(percentage), SUM(passed), MAX(percentage) FROM results").fetchone()
        conn.close()
        attempts = attempts or 0
        return {"attempts": attempts, "average": round(avg or 0, 1),
                "pass_rate": round((passed or 0) / attempts * 100, 1) if attempts else 0,
                "highest": best or 0}

    def exam_averages(self):
        conn = self.db.connect()
        rows = conn.execute("SELECT exam_title, AVG(percentage), COUNT(*) FROM results "
                            "GROUP BY exam_title ORDER BY MAX(id)").fetchall()
        conn.close()
        return [(t, round(a, 1), n) for t, a, n in rows]

    def grade_distribution(self):
        conn = self.db.connect()
        counts = dict(conn.execute("SELECT grade, COUNT(*) FROM results GROUP BY grade").fetchall())
        conn.close()
        return [(g, counts.get(g, 0)) for _, g in self.GRADES]

    def hardest_questions(self, limit=15):
        """Questions with the lowest average score across all attempts."""
        conn = self.db.connect()
        rows = conn.execute("""SELECT question_text, COUNT(*), AVG(MAX(awarded, 0) * 1.0 / max_marks) * 100
                               FROM answers WHERE max_marks > 0 GROUP BY question_text
                               ORDER BY 3 ASC, 2 DESC LIMIT ?""", (limit,)).fetchall()
        conn.close()
        return [(t, n, round(p, 1)) for t, n, p in rows]

    def scorecard_text(self, r):
        status = "PASS" if r.get("passed") else "FAIL"
        return (
            "=" * 40 + "\n"
            "        ONLINE EXAMINATION SCORECARD\n" + "=" * 40 + "\n"
            f"Student      : {r['username']}\n"
            f"Exam         : {r['exam_title']}\n"
            f"Marks        : {r['score']} / {r['total']}\n"
            f"Percentage   : {r['percentage']}%\n"
            f"Grade        : {r['grade']}   ({status})\n"
            f"Correct      : {r.get('correct_count', 0)}\n"
            f"Wrong        : {r.get('wrong_count', 0)}\n"
            f"Unanswered   : {r.get('unanswered', 0)}\n"
            f"Time taken   : {fmt_secs(r.get('time_taken_sec', 0))}\n"
            f"Warnings     : {r.get('warnings', 0)}\n"
            f"Submission   : {'Auto (time up / warnings)' if r['auto_submitted'] else 'Manual'}\n"
            f"Submitted at : {r['submitted_at']}\n" + "=" * 40 + "\n"
        )


