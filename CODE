class GradientCanvas(tk.Canvas):
    def __init__(self, parent, c1, c2, on_draw=None, **kw):
        super().__init__(parent, highlightthickness=0, **kw)
        self.c1, self.c2, self.on_draw = c1, c2, on_draw
        self.bind("<Configure>", self._draw)

    def _draw(self, _=None):
        self.delete("all")
        w, h = self.winfo_width(), self.winfo_height()
        step = 4
        for i in range(0, h, step):
            self.create_rectangle(0, i, w, i + step, fill=blend(self.c1, self.c2, i / max(h, 1)), outline="")
        if self.on_draw:
            self.on_draw(self, w, h)


def draw_bar_chart(canvas, data, max_value=None, integer=False, suffix=""):
    """Draw a simple bar chart on a Canvas. data = [(label, value), ...]."""
    canvas.delete("all")
    w, h = canvas.winfo_width(), canvas.winfo_height()
    if w < 80 or h < 80:
        return
    if not data:
        canvas.create_text(w / 2, h / 2, text="No data yet", fill="#868e96", font=("Segoe UI", 11))
        return
    top_value = max_value or max(1, max(v for _, v in data))
    left, right, top, bottom = 44, 16, 18, 46
    plot_w, plot_h = w - left - right, h - top - bottom
    for i in range(5):                                           # grid lines + y labels
        y = top + plot_h * (1 - i / 4)
        canvas.create_line(left, y, w - right, y, fill="#e9ecef")
        val = top_value * i / 4
        canvas.create_text(left - 6, y, text=str(int(round(val))) if integer or top_value >= 10 else f"{val:.1f}",
                           anchor="e", fill="#868e96", font=("Segoe UI", 8))
    slot = plot_w / len(data)
    bar_w = min(64, slot * 0.6)
    for i, (label, value) in enumerate(data):
        x0 = left + slot * i + (slot - bar_w) / 2
        y1 = top + plot_h
        y0 = y1 - plot_h * min(value, top_value) / top_value
        canvas.create_rectangle(x0, y0, x0 + bar_w, y1, fill=CHART_COLORS[i % len(CHART_COLORS)], outline="")
        shown = f"{int(value)}" if integer else f"{value:.1f}{suffix}"
        canvas.create_text(x0 + bar_w / 2, y0 - 8, text=shown, fill="#212529", font=("Segoe UI", 9, "bold"))
        label = label if len(label) <= 14 else label[:13] + "…"
        canvas.create_text(x0 + bar_w / 2, y1 + 14, text=label, fill="#495057", font=("Segoe UI", 8))


