class AnalyticsPage(ModulePageBase):
    def __init__(self, parent, controller):
        super().__init__(parent, controller, "📈  Reports & Analytics", C_ORANGE)
        self.audit_shown = True

        body = tk.Frame(self, bg=PAGE_BG)
        body.pack(fill="both", expand=True, padx=12, pady=12)
        self.nb = ttk.Notebook(body)
        self.nb.pack(fill="both", expand=True)

        # ---- tab 1: overview ----
        self.overview = tk.Frame(self.nb, bg="white")
        self.nb.add(self.overview, text="📊 Overview")
        self.kpi_row = tk.Frame(self.overview, bg="white")
        self.kpi_row.pack(fill="x", padx=14, pady=14)
        charts = tk.Frame(self.overview, bg="white")
        charts.pack(fill="both", expand=True, padx=14, pady=(0, 14))
        self.avg_data, self.grade_data = [], []
        left = tk.Frame(charts, bg="white", highlightbackground=C_BLUE, highlightthickness=2)
        left.pack(side="left", fill="both", expand=True, padx=(0, 7))
        panel_title(left, "Average score per exam (%)", C_BLUE)
        self.avg_canvas = tk.Canvas(left, bg="white", highlightthickness=0)
        self.avg_canvas.pack(fill="both", expand=True)
        self.avg_canvas.bind("<Configure>", lambda e: draw_bar_chart(self.avg_canvas, self.avg_data, 100, suffix="%"))
        right = tk.Frame(charts, bg="white", highlightbackground=C_GREEN, highlightthickness=2)
        right.pack(side="left", fill="both", expand=True, padx=(7, 0))
        panel_title(right, "Grade distribution (students)", C_GREEN)
        self.grade_canvas = tk.Canvas(right, bg="white", highlightthickness=0)
        self.grade_canvas.pack(fill="both", expand=True)
        self.grade_canvas.bind("<Configure>", lambda e: draw_bar_chart(self.grade_canvas, self.grade_data, integer=True))

        # ---- tab 2: hardest questions ----
        self.hard_tab = tk.Frame(self.nb, bg="white")
        self.nb.add(self.hard_tab, text="❓ Hardest Questions")
        tk.Label(self.hard_tab, text="Questions with the lowest average score across all attempts. "
                                     "Use this to find unclear or very difficult questions.",
                 bg="white", fg="#495057", font=("Segoe UI", 10)).pack(anchor="w", padx=14, pady=(12, 4))
        self.hard_tree = self._make_tree(self.hard_tab, ("Question", "Attempts", "Avg score %"), (620, 90, 110), C_ORANGE)

        # ---- tab 3: audit log (admin) ----
        self.audit_tab = tk.Frame(self.nb, bg="white")
        self.nb.add(self.audit_tab, text="🧾 Audit Log")
        bar = tk.Frame(self.audit_tab, bg="white")
        bar.pack(fill="x", padx=14, pady=(12, 0))
        tk.Label(bar, text="Latest 300 events: logins, exams, user and question changes.", bg="white", fg="#495057",
                 font=("Segoe UI", 10)).pack(side="left")
        HoverButton(bar, "⟳ Refresh", C_BLUE, pady=2, command=self.load_audit).pack(side="right")
        self.audit_tree = self._make_tree(self.audit_tab, ("Time", "User", "Action", "Details"), (150, 110, 160, 460), C_BLUE)

    @staticmethod
    def _make_tree(parent, cols, widths, accent):
        holder = tk.Frame(parent, bg="white")
        holder.pack(fill="both", expand=True, padx=14, pady=12)
        tree = ttk.Treeview(holder, columns=cols, show="headings")
        for c, w in zip(cols, widths):
            tree.heading(c, text=c)
            tree.column(c, width=w, anchor="w" if c in ("Question", "Details") else "center")
        sb = ttk.Scrollbar(holder, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=sb.set)
        tree.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        style_tree(tree, accent)
        return tree

    def on_show(self):
        if not self.controller.require_role("admin", "teacher"):
            self.after(10, self.go_back)
            return
        is_admin = self.controller.auth.has_role("admin")
        if is_admin and not self.audit_shown:
            self.nb.add(self.audit_tab, text="🧾 Audit Log")
            self.audit_shown = True
        elif not is_admin and self.audit_shown:
            self.nb.forget(self.audit_tab)
            self.audit_shown = False
        rg = self.controller.results
        stats = rg.overall_stats()
        for w in self.kpi_row.winfo_children():
            w.destroy()
        for (label, value), col in zip((("Attempts", stats["attempts"]), ("Average score", f"{stats['average']}%"),
                                        ("Pass rate", f"{stats['pass_rate']}%"), ("Highest score", f"{stats['highest']}%")),
                                       TILE_COLORS):
            box = tk.Frame(self.kpi_row, bg=col, width=210, height=78)
            box.pack(side="left", padx=(0, 14))
            box.pack_propagate(False)
            tk.Label(box, text=str(value), bg=col, fg="white", font=("Segoe UI", 22, "bold")).pack(pady=(8, 0))
            tk.Label(box, text=label, bg=col, fg="white", font=("Segoe UI", 10)).pack()
        self.avg_data = [(t, a) for t, a, _ in rg.exam_averages()]
        self.grade_data = rg.grade_distribution()
        draw_bar_chart(self.avg_canvas, self.avg_data, 100, suffix="%")
        draw_bar_chart(self.grade_canvas, self.grade_data, integer=True)

        for row in self.hard_tree.get_children():
            self.hard_tree.delete(row)
        for text, attempts, pct in rg.hardest_questions():
            self.hard_tree.insert("", "end", values=(text, attempts, pct))
        zebra(self.hard_tree)
        if is_admin:
            self.load_audit()

    def load_audit(self):
        for row in self.audit_tree.get_children():
            self.audit_tree.delete(row)
        for r in self.controller.audit.recent():
            self.audit_tree.insert("", "end", values=r)
        zebra(self.audit_tree)


