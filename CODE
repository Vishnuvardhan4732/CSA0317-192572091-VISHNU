class QuestionBank:
    COLUMNS = ("subject", "topic", "difficulty", "qtype", "text",
               "option_a", "option_b", "option_c", "option_d", "answer", "marks")

    PASTE_HELP = (
        "ONE QUESTION PER LINE - separate the parts with  |  (or paste straight from Excel: tabs work too)\n\n"
        "MCQ (4 options):  Question | Option A | Option B | Option C | Option D | Correct letter\n"
        "MCQ + marks:      Question | A | B | C | D | Correct letter | Marks\n"
        "MCQ (2-3 options):Question | Option A | Option B | Correct letter\n"
        "True/False:       Question | True        (or False)\n"
        "Descriptive:      Question | keyword1, keyword2, keyword3\n\n"
        "Leading numbers such as '1.' or 'Q2)' are removed automatically."
    )

    PASTE_EXAMPLE = (
        "1. Which principle does a stack follow? | FIFO | LIFO | Random | Priority | B\n"
        "2. Binary search needs a sorted array. | True\n"
        "3. A queue is used in BFS. | True\n"
        "4. Explain recursion. | function, itself, base case, stack\n"
    )

    def __init__(self, db, audit):
        self.db = db
        self.audit = audit
        self._seed()

    def _validate(self, q):
        if q["qtype"] not in ("MCQ", "TrueFalse", "Descriptive"):
            raise ValueError("Type must be MCQ, TrueFalse or Descriptive")
        if q["difficulty"] not in ("Easy", "Medium", "Hard"):
            raise ValueError("Difficulty must be Easy, Medium or Hard")
        if not q["subject"].strip() or not q["text"].strip() or not q["answer"].strip():
            raise ValueError("Subject, question text and answer are required")
        if q["qtype"] == "MCQ":
            if not q["option_a"] or not q["option_b"]:
                raise ValueError("MCQ needs at least options A and B")
            letter = q["answer"].strip().upper()
            if len(letter) != 1 or letter not in "ABCD":
                raise ValueError("MCQ answer must be A, B, C or D")
            if not q.get({"A": "option_a", "B": "option_b", "C": "option_c", "D": "option_d"}[letter]):
                raise ValueError(f"Answer {letter} points to an empty option")
            q["answer"] = letter
        if q["qtype"] == "TrueFalse":
            if q["answer"].strip().lower() not in ("true", "false"):
                raise ValueError("True/False answer must be True or False")
            q["answer"] = q["answer"].strip().capitalize()
        try:
            q["marks"] = int(q.get("marks") or (2 if q["qtype"] == "Descriptive" else 1))
        except ValueError:
            raise ValueError("Marks must be a whole number")
        if q["marks"] <= 0:
            raise ValueError("Marks must be greater than zero")
        return q

    def add(self, q):
        added, errors = self.add_many([("Question", q)])
        if errors:
            raise ValueError(errors[0].split(": ", 1)[-1])

    def add_many(self, items, skip_duplicates=False):
        """items: list of (label, question-dict). Validates each, then inserts all valid ones in ONE transaction
        (fast even for thousands of questions). Returns (added_count, [error messages]).
        With skip_duplicates, a question whose subject + text already exists is skipped."""
        rows, errors, duplicates = [], [], 0
        seen = set()
        if skip_duplicates:
            conn = self.db.connect()
            seen = {(s.strip().lower(), t.strip().lower()) for s, t in conn.execute("SELECT subject, text FROM questions")}
            conn.close()
        for label, q in items:
            try:
                q = self._validate(dict(q))
                if skip_duplicates:
                    key = (q["subject"].strip().lower(), q["text"].strip().lower())
                    if key in seen:
                        duplicates += 1
                        continue
                    seen.add(key)
                rows.append([q.get(c, "") for c in self.COLUMNS])
            except ValueError as e:
                errors.append(f"{label}: {e}")
        if duplicates:
            errors.append(f"{duplicates} duplicate question(s) skipped (already in the bank)")
        if rows:
            conn = self.db.connect()
            conn.executemany(
                f"INSERT INTO questions ({','.join(self.COLUMNS)}) VALUES ({','.join('?' * len(self.COLUMNS))})", rows)
            conn.commit()
            conn.close()
            self.audit.log("QUESTIONS_ADDED", f"{len(rows)} question(s)")
        return len(rows), errors

    def update(self, qid, q):
        q = self._validate(dict(q))
        conn = self.db.connect()
        conn.execute(f"UPDATE questions SET {','.join(c + '=?' for c in self.COLUMNS)} WHERE id=?",
                     [q.get(c, "") for c in self.COLUMNS] + [qid])
        conn.commit()
        conn.close()
        self.audit.log("QUESTION_UPDATED", f"id={qid}")

    def delete(self, qid):
        self.delete_many([qid])

    def delete_many(self, ids):
        conn = self.db.connect()
        conn.executemany("DELETE FROM questions WHERE id=?", [(i,) for i in ids])
        conn.commit()
        conn.close()
        self.audit.log("QUESTIONS_DELETED", f"{len(ids)} question(s)")

    def get(self, qid):
        conn = self.db.connect()
        conn.row_factory = sqlite3.Row
        row = conn.execute("SELECT * FROM questions WHERE id=?", (qid,)).fetchone()
        conn.close()
        return dict(row) if row else None

    def search(self, subject="", difficulty="", qtype="", keyword=""):
        sql, args = "SELECT * FROM questions WHERE 1=1", []
        for col, val in (("subject", subject), ("difficulty", difficulty), ("qtype", qtype)):
            if val and val != "All":
                sql += f" AND {col}=?"
                args.append(val)
        if keyword.strip():
            sql += " AND (text LIKE ? OR topic LIKE ?)"
            args += [f"%{keyword.strip()}%"] * 2
        conn = self.db.connect()
        conn.row_factory = sqlite3.Row
        rows = [dict(r) for r in conn.execute(sql + " ORDER BY id", args)]
        conn.close()
        return rows

    def subjects(self):
        conn = self.db.connect()
        subs = [r[0] for r in conn.execute("SELECT DISTINCT subject FROM questions ORDER BY subject")]
        conn.close()
        return subs

    # ---------- CSV import / export ----------
    def bulk_upload(self, csv_path):
        """CSV header: subject,topic,difficulty,qtype,text,option_a..option_d,answer,marks."""
        items = []
        with open(csv_path, newline="", encoding="utf-8-sig") as f:
            for line_no, row in enumerate(csv.DictReader(f), start=2):
                items.append((f"Line {line_no}", {c: (row.get(c) or "").strip() for c in self.COLUMNS}))
        return self.add_many(items, skip_duplicates=True)

    def export_csv(self, path, rows):
        with open(path, "w", newline="", encoding="utf-8-sig") as f:
            w = csv.writer(f)
            w.writerow(self.COLUMNS)
            for q in rows:
                w.writerow([q[c] for c in self.COLUMNS])

    def write_template(self, path):
        with open(path, "w", newline="", encoding="utf-8-sig") as f:
            w = csv.writer(f)
            w.writerow(self.COLUMNS)
            w.writerow(["Data Structures", "Stack", "Easy", "MCQ", "Which principle does a stack follow?",
                        "FIFO", "LIFO", "Random", "Priority", "B", 1])
            w.writerow(["Data Structures", "Array", "Easy", "TrueFalse", "Arrays use contiguous memory.",
                        "", "", "", "", "True", 1])
            w.writerow(["Data Structures", "Linked List", "Medium", "Descriptive", "Explain a linked list.",
                        "", "", "", "", "node, pointer, dynamic", 2])

    # ---------- bulk entry: copy & paste ----------
    def parse_paste(self, text, subject, topic, difficulty):
        """Turn pasted text (one question per line) into question dicts. Returns (items, errors)."""
        items, errors = [], []
        for n, raw in enumerate(text.splitlines(), start=1):
            line = raw.strip()
            if not line:
                continue
            parts = [p.strip() for p in (line.split("|") if "|" in line else line.split("\t"))]
            if len(parts) >= 3 and re.fullmatch(r"(?:Q\s*)?\d+\s*[\.\)\:]?", parts[0], flags=re.I):
                parts = parts[1:]                          # leading serial-number column (e.g. from Excel)
            parts[0] = re.sub(r"^\s*(?:Q\s*)?\d+\s*[\.\)\:]\s*", "", parts[0], flags=re.I)
            q = {"subject": subject, "topic": topic, "difficulty": difficulty, "marks": "",
                 "option_a": "", "option_b": "", "option_c": "", "option_d": ""}
            n_parts = len(parts)
            if n_parts >= 6:                               # Q | A | B | C | D | letter [| marks]
                q.update(qtype="MCQ", text=parts[0], option_a=parts[1], option_b=parts[2],
                         option_c=parts[3], option_d=parts[4], answer=parts[5])
                if n_parts >= 7:
                    q["marks"] = parts[6]
            elif n_parts in (4, 5):                        # Q | A | B [| C] | letter
                q.update(qtype="MCQ", text=parts[0], answer=parts[-1])
                for key, val in zip(("option_a", "option_b", "option_c"), parts[1:-1]):
                    q[key] = val
            elif n_parts in (2, 3):                        # Q | True/False  or  Q | keywords  [| marks]
                q.update(text=parts[0], answer=parts[1])
                q["qtype"] = "TrueFalse" if parts[1].lower() in ("true", "false") else "Descriptive"
                if n_parts == 3:
                    q["marks"] = parts[2]
            else:
                errors.append(f"Line {n}: could not recognise the format (use | between the parts)")
                continue
            items.append((f"Line {n}", q))
        return items, errors

    def bulk_paste(self, text, subject, topic, difficulty):
        if not subject.strip():
            raise ValueError("Please enter a subject for the pasted questions")
        subject = next((s for s in self.subjects() if s.lower() == subject.strip().lower()), subject.strip())
        items, parse_errors = self.parse_paste(text, subject, topic.strip(), difficulty)
        added, errors = self.add_many(items, skip_duplicates=True)
        return added, parse_errors + errors

    def _seed(self):
        if self.search():
            return
        S = "Data Structures"
        sample = [
            (S, "Stack", "Easy", "MCQ", "Which principle does a stack follow?", "FIFO", "LIFO", "Random", "Priority", "B", 1),
            (S, "Queue", "Easy", "MCQ", "Which data structure is used for BFS?", "Stack", "Heap", "Queue", "Tree", "C", 1),
            (S, "Hash Table", "Medium", "MCQ", "Average time to search in a hash table?", "O(n)", "O(log n)", "O(1)", "O(n^2)", "C", 1),
            (S, "Heap", "Medium", "MCQ", "A min-heap always keeps which element at the root?", "Largest", "Smallest", "Median", "Newest", "B", 1),
            (S, "Tree", "Medium", "TrueFalse", "A binary search tree can contain duplicate keys in its standard definition.", "", "", "", "", "False", 1),
            (S, "Array", "Easy", "TrueFalse", "Array elements are stored in contiguous memory.", "", "", "", "", "True", 1),
            (S, "Sorting", "Hard", "MCQ", "Worst-case time complexity of quicksort?", "O(n log n)", "O(n)", "O(n^2)", "O(log n)", "C", 1),
            (S, "Linked List", "Medium", "Descriptive", "Explain a linked list and one advantage over arrays.", "", "", "", "",
             "node,pointer,dynamic,insertion,deletion", 2),
        ]
        conn = self.db.connect()
        rows = []
        for s in sample:
            q = self._validate(dict(zip(self.COLUMNS, s)))
            rows.append([q.get(c, "") for c in self.COLUMNS])
        conn.executemany(
            f"INSERT INTO questions ({','.join(self.COLUMNS)}) VALUES ({','.join('?' * len(self.COLUMNS))})", rows)
        conn.commit()
        conn.close()


