def prepare_question(q, shuffle):
    """Copy of a question for one student. MCQ options are shuffled and the answer letter re-mapped."""
    q = dict(q)
    if shuffle and q["qtype"] == "MCQ":
        options = [q["option_" + L.lower()] for L in "ABCD" if q["option_" + L.lower()]]
        correct_text = q["option_" + q["answer"].lower()]
        random.shuffle(options)
        for i, L in enumerate("ABCD"):
            q["option_" + L.lower()] = options[i] if i < len(options) else ""
        q["answer"] = "ABCD"[options.index(correct_text)]
    return q


class ExamSession:
    """One student's running attempt. Questions live in a deque (queue) for navigation."""

    def __init__(self, exam, questions, username):
        self.exam = exam
        self.username = username
        self.questions = list(questions)
        self.index = 0
        self.answers = {}                         # question id -> answer (hash map)
        self.flagged = set()                      # indexes marked for review
        self.warnings = 0                         # proctoring warnings
        self.started = datetime.now()
        deadline = self.started + timedelta(minutes=exam["duration_min"])
        end = exam.get("end_time") or ""
        if end:
            try:
                deadline = min(deadline, datetime.strptime(end, DT_FMT))
            except ValueError:
                pass
        self.deadline = deadline
        self.finished = False

    def current(self):
        return self.questions[self.index]

    def remaining_seconds(self):
        return max(0, int((self.deadline - datetime.now()).total_seconds()))

    def elapsed_seconds(self):
        return max(0, int((datetime.now() - self.started).total_seconds()))

    def is_answered(self, i):
        return bool(str(self.answers.get(self.questions[i]["id"], "")).strip())

    def answered_count(self):
        return sum(1 for i in range(len(self.questions)) if self.is_answered(i))


class ExamManager:
    def __init__(self, db, question_bank, audit):
        self.db = db
        self.qb = question_bank
        self.audit = audit
        self.active = {}                          # username -> ExamSession (for live monitoring)
        self._seed()

    def schedule(self, title, subject, start_time, duration_min, num_questions,
                 end_time="", negative=0.0, shuffle=True, pass_percent=50.0):
        try:
            datetime.strptime(start_time, DT_FMT)
            end_time = (end_time or "").strip()
            if end_time:
                datetime.strptime(end_time, DT_FMT)
            duration_min, num_questions = int(duration_min), int(num_questions)
            negative, pass_percent = float(negative), float(pass_percent)
        except ValueError:
            raise ValueError("Start/End must be 'YYYY-MM-DD HH:MM' (End is optional); "
                             "minutes, questions, negative marking and pass % must be numbers")
        if not title.strip() or not subject.strip():
            raise ValueError("Title and subject are required")
        if duration_min <= 0 or num_questions <= 0:
            raise ValueError("Duration and question count must be positive")
        if end_time and end_time <= start_time:
            raise ValueError("End time must be later than the start time")
        if not 0 <= negative <= 1:
            raise ValueError("Negative marking must be between 0 and 1 (for example 0.25)")
        if not 0 <= pass_percent <= 100:
            raise ValueError("Pass percentage must be between 0 and 100")
        available = len(self.qb.search(subject=subject))
        if available == 0:
            raise ValueError(f"No questions found for subject '{subject}'.\n"
                             f"Choose a subject that exists in the Question Bank: "
                             f"{', '.join(self.qb.subjects()) or '(bank is empty)'}")
        if num_questions > available:
            raise ValueError(f"Only {available} question(s) available for '{subject}', "
                             f"but you asked for {num_questions}.")
        conn = self.db.connect()
        conn.execute("""INSERT INTO exams (title, subject, start_time, duration_min, num_questions,
                        end_time, negative_marking, shuffle, pass_percent) VALUES (?,?,?,?,?,?,?,?,?)""",
                     (title.strip(), subject, start_time, duration_min, num_questions,
                      end_time, negative, int(bool(shuffle)), pass_percent))
        conn.commit()
        conn.close()
        self.audit.log("EXAM_SCHEDULED", f"{title.strip()} ({start_time})")

    def list_exams(self):
        conn = self.db.connect()
        conn.row_factory = sqlite3.Row
        rows = [dict(r) for r in conn.execute("SELECT * FROM exams ORDER BY start_time")]
        conn.close()
        return rows

    def delete(self, exam_id):
        if any(s.exam["id"] == exam_id for s in self.active.values()):
            raise ValueError("A student is taking this exam right now, so it cannot be deleted")
        conn = self.db.connect()
        conn.execute("DELETE FROM exams WHERE id=?", (exam_id,))
        conn.commit()
        conn.close()
        self.audit.log("EXAM_DELETED", f"id={exam_id}")

    def already_taken(self, username, exam_id):
        conn = self.db.connect()
        n = conn.execute("SELECT COUNT(*) FROM results WHERE username=? AND exam_id=?",
                         (username, exam_id)).fetchone()[0]
        conn.close()
        return n > 0

    def status(self, exam, username=None):
        """Upcoming / Live / Closed  (or Completed for a student who already submitted)."""
        if username and self.already_taken(username, exam["id"]):
            return "Completed"
        now = now_str()
        if now < exam["start_time"]:
            return "Upcoming"
        if (exam.get("end_time") or "") and now > exam["end_time"]:
            return "Closed"
        return "Live"

    def start(self, exam, username):
        status = self.status(exam, username)
        if status == "Upcoming":
            raise ValueError(f"This exam opens at {exam['start_time']}.")
        if status == "Closed":
            raise ValueError(f"This exam closed at {exam['end_time']}.")
        if status == "Completed":
            raise ValueError("You have already submitted this exam.")
        pool = self.qb.search(subject=exam["subject"])
        if not pool:
            raise ValueError("There are no questions for this exam's subject.")
        picked = random.sample(pool, min(exam["num_questions"], len(pool)))   # random selection
        if exam.get("shuffle", 1):
            random.shuffle(picked)
        questions = deque(prepare_question(q, exam.get("shuffle", 1)) for q in picked)
        session = ExamSession(exam, questions, username)
        self.active[username] = session
        self.audit.log("EXAM_STARTED", exam["title"])
        return session

    def end(self, username):
        self.active.pop(username, None)

    def monitoring_rows(self):
        rows = []
        for user, s in self.active.items():
            rows.append((user, s.exam["title"], f"{s.answered_count()}/{len(s.questions)}",
                         fmt_secs(s.remaining_seconds()), s.warnings))
        return rows

    def _seed(self):
        if not self.list_exams():
            start = (datetime.now() - timedelta(hours=1)).strftime(DT_FMT)
            self.schedule("Data Structures Quiz 1", "Data Structures", start, 10, 6)


