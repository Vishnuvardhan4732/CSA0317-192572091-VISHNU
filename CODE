class ResultPage(ModulePageBase):
    def __init__(self, parent, controller):
        super().__init__(parent, controller, "📊  Automatic Result Generation", C_GREEN)
        self.focus_result = None
        self.rows = {}
        self.current = None

        body = tk.Frame(self, bg=PAGE_BG)
        body.pack(fill="both", expand=True, padx=12, pady=12)

        left = card(body, C_GREEN, width=400)
        left.pack(side="left", fill="y", padx=(0, 12))
        left.pack_propagate(False)
        panel_title(left, "🧾  Scorecard", C_GREEN)
        self.card_box = tk.Text(left, width=44, height=14, bg="#e6f7f4", fg="#12423b", relief="flat",
                                font=("Consolas", 9), wrap="word")
        self.card_box.pack(padx=14, pady=10, fill="x")
        btns = tk.Frame(left, bg="white")
        btns.pack(fill="x", padx=14)
        btns.columnconfigure(0, weight=1)
        btns.columnconfigure(1, weight=1)
        HoverButton(btns, "🔍 Answer Review", C_ORANGE, pady=4, command=self.show_review).grid(
            row=0, column=0, columnspan=2, sticky="we", pady=2)
        HoverButton(btns, "💾 Download", C_GREEN, pady=4, command=self.download).grid(row=1, column=0, sticky="we", padx=(0, 2), pady=2)
        HoverButton(btns, "🖨 Print", C_PURPLE, pady=4, command=self.print_card).grid(row=1, column=1, sticky="we", padx=(2, 0), pady=2)
        HoverButton(btns, "📤 Export Listed Results (CSV)", C_BLUE, pady=4, command=self.export_all).grid(
            row=2, column=0, columnspan=2, sticky="we", pady=2)

        self.board_title = tk.Label(left, text="", bg=C_ORANGE, fg="white", anchor="w", padx=14, pady=7,
                                    font=("Segoe UI", 11, "bold"))
        self.board_title.pack(fill="x", pady=(10, 0))
        self.board = tk.Listbox(left, height=6, font=("Consolas", 10), relief="flat", bg="#fff3e0", fg="#6b3a00",
                                selectbackground=C_YELLOW)
        self.board.pack(fill="x", padx=14, pady=10)

        right = card(body, C_GREEN)
        right.pack(side="left", fill="both", expand=True)
        panel_title(right, "🗄  Stored Results", NAVY)
        filt = tk.Frame(right, bg="white")
        filt.pack(fill="x", padx=14, pady=(10, 0))
        tk.Label(filt, text="Exam:", bg="white", font=("Segoe UI", 10, "bold")).pack(side="left")
        self.exam_filter = tk.StringVar(value="All")
        self.filter_combo = ttk.Combobox(filt, textvariable=self.exam_filter, state="readonly", width=28)
        self.filter_combo.pack(side="left", padx=6)
        self.filter_combo.bind("<<ComboboxSelected>>", lambda e: self.refresh())
        self.count_label = tk.Label(filt, text="", bg="white", fg=C_PURPLE, font=("Segoe UI", 10, "bold"))
        self.count_label.pack(side="right")
        cols = ("Student", "Exam", "Score", "Percent", "Grade", "Result", "Submitted")
        self.tree = ttk.Treeview(right, columns=cols, show="headings")
        for c in cols:
            self.tree.heading(c, text=c)
            self.tree.column(c, anchor="center", width=100)
        self.tree.pack(fill="both", expand=True, padx=14, pady=14)
        self.tree.tag_configure("good", background="#d8f3dc")
        self.tree.tag_configure("mid", background="#fff3bf")
        self.tree.tag_configure("bad", background="#ffd6d6")
        self.tree.bind("<<TreeviewSelect>>", self.on_select)

    def _only_self(self):
        auth = self.controller.auth
        return auth.current_user["username"] if auth.has_role("student") else None

    def on_show(self):
        only_self = self._only_self()
        titles = sorted({r["exam_title"] for r in self.controller.results.list_results(only_self)})
        self.filter_combo["values"] = ["All"] + titles
        if self.exam_filter.get() not in ["All"] + titles:
            self.exam_filter.set("All")
        self.refresh()
        self.board_title.config(text="🏆  My Best Scores" if only_self else "🏆  Top Scores (heap)")
        self.board.delete(0, "end")
        for i, r in enumerate(self.controller.results.leaderboard(username=only_self), 1):
            medal = {1: "🥇", 2: "🥈", 3: "🥉"}.get(i, f"{i}.")
            self.board.insert("end", f" {medal} {r['username']:<10} {r['percentage']:>6}%  {r['grade']}")

        target = str(self.focus_result) if self.focus_result else None
        self.focus_result = None
        if target in self.rows:
            self.tree.selection_set(target)
            self.show_card(self.rows[target])

    def refresh(self):
        for row in self.tree.get_children():
            self.tree.delete(row)
        self.rows = {}
        wanted = self.exam_filter.get()
        for r in self.controller.results.list_results(self._only_self()):
            if wanted != "All" and r["exam_title"] != wanted:
                continue
            iid = str(r["id"])
            self.rows[iid] = r
            tag = "good" if r["percentage"] >= 80 else "mid" if r["percentage"] >= 50 else "bad"
            self.tree.insert("", "end", iid=iid, tags=(tag,), values=(
                r["username"], r["exam_title"], f"{r['score']}/{r['total']}", f"{r['percentage']}%",
                r["grade"], "PASS" if r.get("passed") else "FAIL", r["submitted_at"]))
        self.count_label.config(text=f"{len(self.rows)} result(s)")
        self.current = None
        self._set_card("Select a result to view its scorecard.")

    def _set_card(self, text):
        self.card_box.config(state="normal")
        self.card_box.delete("1.0", "end")
        self.card_box.insert("1.0", text)
        self.card_box.config(state="disabled")

    def show_card(self, r):
        self.current = r
        self._set_card(self.controller.results.scorecard_text(r))

    def on_select(self, _):
        sel = self.tree.selection()
        if sel and sel[0] in self.rows:
            self.show_card(self.rows[sel[0]])

    def _current_text(self):
        r = self.current
        if not r:
            messagebox.showwarning("No Selection", "Select a result first.")
            return None, None
        return r, self.controller.results.scorecard_text(r)

    def show_review(self):
        r = self.current
        if not r:
            return messagebox.showwarning("No Selection", "Select a result first.")
        rows = self.controller.results.details(r["id"])
        if not rows:
            return messagebox.showinfo("No Details", "No answer details were stored for this result.")
        win = tk.Toplevel(self)
        win.title(f"Answer Review - {r['username']} - {r['exam_title']}")
        win.geometry("1040x560")
        win.configure(bg=PAGE_BG)
        win.transient(self)
        tk.Label(win, text=f"🔍  Answer Review   ·   {r['exam_title']}   ·   {r['score']}/{r['total']}  ({r['percentage']}%)",
                 bg=C_ORANGE, fg="white", anchor="w", padx=16, pady=10, font=("Segoe UI", 13, "bold")).pack(fill="x")
        HoverButton(win, "Close", C_RED, command=win.destroy).pack(side="bottom", anchor="e", padx=16, pady=10)
        holder = tk.Frame(win, bg=PAGE_BG)
        holder.pack(fill="both", expand=True, padx=16, pady=12)
        cols = ("#", "Question", "Your Answer", "Correct Answer", "Marks", "Result")
        tree = ttk.Treeview(holder, columns=cols, show="headings")
        for c, w in zip(cols, (40, 380, 170, 170, 70, 90)):
            tree.heading(c, text=c)
            tree.column(c, width=w, anchor="w" if c in ("Question", "Your Answer", "Correct Answer") else "center")
        sb = ttk.Scrollbar(holder, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=sb.set)
        tree.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        for tag, col in (("Correct", "#d8f3dc"), ("Partial", "#fff3bf"), ("Wrong", "#ffd6d6"), ("Unanswered", "#e9ecef")):
            tree.tag_configure(tag, background=col)
        for i, a in enumerate(rows, 1):
            tree.insert("", "end", tags=(a["status"],), values=(
                i, a["question_text"], a["given"], a["correct"], f"{a['awarded']}/{a['max_marks']}", a["status"]))

    def download(self):
        r, text = self._current_text()
        if not r:
            return
        path = filedialog.asksaveasfilename(defaultextension=".txt", initialfile=f"scorecard_{r['username']}_{r['id']}.txt",
                                            filetypes=[("Text file", "*.txt")])
        if path:
            with open(path, "w", encoding="utf-8") as f:
                f.write(text)
            messagebox.showinfo("Saved", f"Scorecard saved to:\n{path}")

    def export_all(self):
        if not self.rows:
            return messagebox.showinfo("No Data", "There are no results to export.")
        path = filedialog.asksaveasfilename(defaultextension=".csv", initialfile="exam_results.csv",
                                            filetypes=[("CSV file", "*.csv")])
        if not path:
            return
        with open(path, "w", newline="", encoding="utf-8-sig") as f:
            w = csv.writer(f)
            w.writerow(["Student", "Exam", "Score", "Total", "Percentage", "Grade", "Result", "Correct", "Wrong",
                        "Unanswered", "Time taken", "Warnings", "Submission", "Submitted at"])
            for r in sorted(self.rows.values(), key=lambda r: r["id"]):
                w.writerow([r["username"], r["exam_title"], r["score"], r["total"], r["percentage"], r["grade"],
                            "PASS" if r.get("passed") else "FAIL", r.get("correct_count", 0), r.get("wrong_count", 0),
                            r.get("unanswered", 0), fmt_secs(r.get("time_taken_sec", 0)), r.get("warnings", 0),
                            "Auto" if r["auto_submitted"] else "Manual", r["submitted_at"]])
        messagebox.showinfo("Exported", f"{len(self.rows)} result(s) saved to:\n{path}")

    def print_card(self):
        r, text = self._current_text()
        if not r:
            return
        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "print_scorecard.txt")
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)
        try:
            if os.name == "nt":
                os.startfile(path, "print")
            else:
                os.system(f'lp "{path}" 2>/dev/null')
            messagebox.showinfo("Print", "Scorecard sent to the default printer.")
        except Exception as e:
            messagebox.showerror("Print Failed", str(e))


