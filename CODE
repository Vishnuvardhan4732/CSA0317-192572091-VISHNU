class Database:
    """Single SQLite file shared by every module."""

    def __init__(self, path="exam_data.db"):
        self.path = path
        self._init_db()

    def connect(self):
        return sqlite3.connect(self.path)

    @staticmethod
    def _ensure_columns(cur, table, columns):
        """Add missing columns so databases made by older versions keep working.
        Returns the set of columns that were just added."""
        existing = {r[1] for r in cur.execute(f"PRAGMA table_info({table})")}
        added = set()
        for col, ddl in columns.items():
            if col not in existing:
                cur.execute(f"ALTER TABLE {table} ADD COLUMN {col} {ddl}")
                added.add(col)
        return added

    def _init_db(self):
        conn = self.connect()
        cur = conn.cursor()
        cur.execute("""CREATE TABLE IF NOT EXISTS users (
            username TEXT PRIMARY KEY, password_hash TEXT NOT NULL, salt TEXT NOT NULL,
            role TEXT NOT NULL, full_name TEXT)""")
        self._ensure_columns(cur, "users", {"email": "TEXT DEFAULT ''", "phone": "TEXT DEFAULT ''",
                                            "department": "TEXT DEFAULT ''"})
        cur.execute("""CREATE TABLE IF NOT EXISTS questions (
            id INTEGER PRIMARY KEY AUTOINCREMENT, subject TEXT, topic TEXT, difficulty TEXT,
            qtype TEXT, text TEXT, option_a TEXT, option_b TEXT, option_c TEXT, option_d TEXT,
            answer TEXT, marks INTEGER DEFAULT 1)""")
        cur.execute("""CREATE TABLE IF NOT EXISTS exams (
            id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT, subject TEXT,
            start_time TEXT, duration_min INTEGER, num_questions INTEGER)""")
        self._ensure_columns(cur, "exams", {"end_time": "TEXT DEFAULT ''", "negative_marking": "REAL DEFAULT 0",
                                            "shuffle": "INTEGER DEFAULT 1", "pass_percent": "REAL DEFAULT 50"})
        cur.execute("""CREATE TABLE IF NOT EXISTS results (
            id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT, exam_id INTEGER, exam_title TEXT,
            score REAL, total REAL, percentage REAL, grade TEXT, auto_submitted INTEGER,
            submitted_at DATETIME DEFAULT CURRENT_TIMESTAMP)""")
        added = self._ensure_columns(cur, "results", {
            "correct_count": "INTEGER DEFAULT 0", "wrong_count": "INTEGER DEFAULT 0",
            "unanswered": "INTEGER DEFAULT 0", "time_taken_sec": "INTEGER DEFAULT 0",
            "warnings": "INTEGER DEFAULT 0", "passed": "INTEGER DEFAULT 0"})
        if "passed" in added:                       # results stored by an older version
            cur.execute("UPDATE results SET passed = CASE WHEN percentage >= 50 THEN 1 ELSE 0 END")
        cur.execute("""CREATE TABLE IF NOT EXISTS answers (
            id INTEGER PRIMARY KEY AUTOINCREMENT, result_id INTEGER, question_id INTEGER, qtype TEXT,
            question_text TEXT, given TEXT, correct TEXT, awarded REAL, max_marks REAL, status TEXT)""")
        cur.execute("""CREATE TABLE IF NOT EXISTS audit_log (
            id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp TEXT, username TEXT, action TEXT, details TEXT)""")
        conn.commit()
        conn.close()


class AuditLog:
    """Who did what, and when (login, exam activity, user and question changes)."""

    def __init__(self, db):
        self.db = db
        self.actor = "system"

    def log(self, action, details="", actor=None):
        try:
            conn = self.db.connect()
            conn.execute("INSERT INTO audit_log (timestamp, username, action, details) VALUES (?,?,?,?)",
                         (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), actor or self.actor, action, details))
            conn.commit()
            conn.close()
        except sqlite3.Error:
            pass                                    # logging must never break the application

    def recent(self, limit=300):
        conn = self.db.connect()
        rows = conn.execute("SELECT timestamp, username, action, details FROM audit_log "
                            "ORDER BY id DESC LIMIT ?", (limit,)).fetchall()
        conn.close()
        return rows


