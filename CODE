    def on_show(self):
        if not self.controller.require_role("admin", "teacher"):
            self.after(10, self.go_back)
            return
        self.subject_combo["values"] = ["All"] + self.controller.qbank.subjects()
        self.refresh()

    def reset_filters(self):
        self.f_subject.set("All")
        self.f_diff.set("All")
        self.f_type.set("All")
        self.f_search.set("")
        self.refresh()

    def _shown(self):
        return self.controller.qbank.search(self.f_subject.get(), self.f_diff.get(), self.f_type.get(),
                                            self.f_search.get())

    def refresh(self):
        for row in self.tree.get_children():
            self.tree.delete(row)
        rows = self._shown()
        for q in rows:
            self.tree.insert("", "end", iid=str(q["id"]),
                             values=(q["id"], q["subject"], q["topic"], q["difficulty"], q["qtype"],
                                     q["text"], q["answer"]))
        zebra(self.tree)
        self.count_label.config(text=f"{len(rows)} question(s)")

    def select_all(self):
        self.tree.selection_set(self.tree.get_children())

    def _form_data(self):
        data = {k: v.get().strip() for k, v in self.vars.items()}
        data["text"] = self.text_box.get("1.0", "end").strip()
        return data

    def clear_form(self):
        self.selected_id = None
        for k, v in self.vars.items():
            v.set("Easy" if k == "difficulty" else "MCQ" if k == "qtype" else "")
        self.text_box.delete("1.0", "end")

    def on_select(self, _):
        sel = self.tree.selection()
        if len(sel) != 1:          # several rows selected (for deleting): leave the form alone
            return
        q = self.controller.qbank.get(int(sel[0]))
        if not q:
            return
        self.selected_id = q["id"]
        for k, v in self.vars.items():
            v.set(q[k])
        self.text_box.delete("1.0", "end")
        self.text_box.insert("1.0", q["text"])

    def _run(self, action, success):
        try:
            action()
            messagebox.showinfo("Success", success)
            self.on_show()
        except ValueError as e:
            messagebox.showerror("Invalid Data", str(e))

    def add(self):
        self._run(lambda: self.controller.qbank.add(self._form_data()), "Question added.")

    def update(self):
        if self.selected_id is None:
            return messagebox.showwarning("No Selection", "Select a question from the table first.")
        self._run(lambda: self.controller.qbank.update(self.selected_id, self._form_data()), "Question updated.")

    def delete(self):
        ids = [int(i) for i in self.tree.selection()]
        if not ids:
            return messagebox.showwarning(
                "No Selection", "Select one or more questions in the table first.\n\n"
                                "Tip: Ctrl+click or Shift+click to select several, Ctrl+A selects all shown.")
        if messagebox.askyesno("Confirm", f"Delete {len(ids)} selected question(s)?"):
            self.controller.qbank.delete_many(ids)
            self.clear_form()
            self.on_show()

    def delete_all_shown(self):
        ids = [int(i) for i in self.tree.get_children()]
        if not ids:
            return messagebox.showinfo("Nothing to delete", "No questions are shown in the table.")
        if messagebox.askyesno("Delete ALL shown questions",
                               f"This will permanently delete all {len(ids)} question(s) currently shown "
                               f"(use the filters first to narrow the list).\n\nContinue?", icon="warning"):
            self.controller.qbank.delete_many(ids)
            self.clear_form()
            self.on_show()

    def bulk_upload(self):
        path = filedialog.askopenfilename(filetypes=[("CSV files", "*.csv")])
        if not path:
            return
        try:
            added, errors = self.controller.qbank.bulk_upload(path)
        except Exception as e:
            return messagebox.showerror("Upload Failed", str(e))
        self._report(added, errors, "CSV Upload")

    def save_template(self):
        path = filedialog.asksaveasfilename(defaultextension=".csv", initialfile="question_template.csv",
                                            filetypes=[("CSV file", "*.csv")])
        if path:
            self.controller.qbank.write_template(path)
            messagebox.showinfo("Saved", f"Template saved to:\n{path}\n\nFill it in Excel, then use 'Upload CSV'.")

    def export_shown(self):
        rows = self._shown()
        if not rows:
            return messagebox.showinfo("No Data", "No questions are shown to export.")
        path = filedialog.asksaveasfilename(defaultextension=".csv", initialfile="question_bank.csv",
                                            filetypes=[("CSV file", "*.csv")])
        if path:
            self.controller.qbank.export_csv(path, rows)
            messagebox.showinfo("Exported", f"{len(rows)} question(s) saved to:\n{path}")

    def _report(self, added, errors, title, parent=None):
        msg = f"✅ {added} question(s) added."
        if errors:
            msg += f"\n\n⚠ {len(errors)} line(s) skipped:\n" + "\n".join(errors[:10])
            if len(errors) > 10:
                msg += f"\n... and {len(errors) - 10} more"
        messagebox.showinfo(title, msg, parent=parent)
        self.on_show()

    # ---------- copy & paste many questions at once ----------
    def open_paste_dialog(self):
        win = tk.Toplevel(self)
        win.title("Bulk Paste Questions")
        win.geometry("880x700")
        win.minsize(760, 560)
        win.configure(bg=PAGE_BG)
        win.transient(self)

        tk.Label(win, text="📋  Paste Questions in Bulk", bg=C_GREEN, fg="white", anchor="w", padx=16, pady=10,
                 font=("Segoe UI", 15, "bold")).pack(fill="x")

        top = tk.Frame(win, bg=PAGE_BG)
        top.pack(fill="x", padx=16, pady=10)
        subject = tk.StringVar(value=self.f_subject.get() if self.f_subject.get() != "All" else "")
        topic = tk.StringVar()
        diff = tk.StringVar(value="Medium")
        tk.Label(top, text="Subject*", bg=PAGE_BG, font=("Segoe UI", 10, "bold")).grid(row=0, column=0, sticky="w")
        ttk.Combobox(top, textvariable=subject, values=self.controller.qbank.subjects(), width=22).grid(row=0, column=1, padx=(4, 16))
        tk.Label(top, text="Topic", bg=PAGE_BG, font=("Segoe UI", 10, "bold")).grid(row=0, column=2, sticky="w")
        tk.Entry(top, textvariable=topic, width=20, relief="solid", bd=1).grid(row=0, column=3, padx=(4, 16))
        tk.Label(top, text="Difficulty", bg=PAGE_BG, font=("Segoe UI", 10, "bold")).grid(row=0, column=4, sticky="w")
        ttk.Combobox(top, textvariable=diff, values=["Easy", "Medium", "Hard"], state="readonly", width=10).grid(row=0, column=5, padx=4)

        guide = tk.Label(win, text=QuestionBank.PASTE_HELP, bg="#e6f7f4", fg="#1b5e53", justify="left", anchor="w",
                         font=("Consolas", 9), padx=12, pady=8, highlightbackground=C_GREEN, highlightthickness=1)
        guide.pack(fill="x", padx=16)

        # buttons + counter are packed at the BOTTOM first so they can never be pushed out of the window
        btns = tk.Frame(win, bg=PAGE_BG)
        btns.pack(side="bottom", fill="x", padx=16, pady=(4, 14))
        status = tk.Label(win, text="0 line(s) detected", bg=PAGE_BG, fg=C_PURPLE, font=("Segoe UI", 10, "bold"))
        status.pack(side="bottom", anchor="w", padx=16)

        holder = tk.Frame(win, bg=PAGE_BG)
        holder.pack(fill="both", expand=True, padx=16, pady=10)
        text = tk.Text(holder, wrap="none", height=8, font=("Consolas", 10), relief="solid", bd=1, undo=True)
        ys = ttk.Scrollbar(holder, orient="vertical", command=text.yview)
        text.configure(yscrollcommand=ys.set)
        text.pack(side="left", fill="both", expand=True)
        ys.pack(side="right", fill="y")

        def update_count(_=None):
            n = sum(1 for ln in text.get("1.0", "end").splitlines() if ln.strip())
            status.config(text=f"{n} line(s) detected")
        text.bind("<KeyRelease>", update_count)
        text.bind("<<Paste>>", lambda e: win.after(50, update_count))

        def insert_example():
            text.delete("1.0", "end")
            text.insert("1.0", QuestionBank.PASTE_EXAMPLE)
            update_count()

        def submit():
            content = text.get("1.0", "end")
            if not content.strip():
                return messagebox.showwarning("Nothing to add", "Paste some questions first.", parent=win)
            # guard against typos creating a second subject (e.g. "Data structure" vs "Data Structures")
            chosen = subject.get().strip()
            existing = self.controller.qbank.subjects()
            if chosen and chosen.lower() not in (s.lower() for s in existing) and existing:
                close = difflib.get_close_matches(chosen, existing, n=1, cutoff=0.75)
                if close:
                    ans = messagebox.askyesnocancel(
                        "Similar subject found",
                        f"'{chosen}' is not an existing subject.\n\nDid you mean '{close[0]}'?\n\n"
                        f"Yes = use '{close[0]}'\nNo = create new subject '{chosen}'\nCancel = go back", parent=win)
                    if ans is None:
                        return
                    if ans:
                        subject.set(close[0])
                elif not messagebox.askyesno("New subject", f"'{chosen}' is a new subject.\nCreate it?", parent=win):
                    return
            try:
                added, errors = self.controller.qbank.bulk_paste(content, subject.get(), topic.get(), diff.get())
            except ValueError as e:
                return messagebox.showerror("Missing Data", str(e), parent=win)
            self._report(added, errors, "Bulk Paste", parent=win)
            if added:
                win.destroy()

        HoverButton(btns, "✅  Add All Questions", C_GREEN, command=submit).pack(side="left")
        HoverButton(btns, "💡  Insert Example", C_ORANGE, command=insert_example).pack(side="left", padx=8)
        HoverButton(btns, "🧹  Clear", C_GRAY, command=lambda: (text.delete("1.0", "end"), update_count())).pack(side="left")
        HoverButton(btns, "Close", C_RED, command=win.destroy).pack(side="right")
        text.focus_set()


