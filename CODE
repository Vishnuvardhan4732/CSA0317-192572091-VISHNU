STATUS_COLORS = {"Live": "#d8f3dc", "Upcoming": "#fff3bf", "Closed": "#e9ecef", "Completed": "#d0ebff"}


class ExamPage(ModulePageBase):
    def __init__(self, parent, controller):
        super().__init__(parent, controller, "📝  Exam Module", C_RED)
        self.session = None
        self.timer_job = None
        self.monitor_job = None

        body = tk.Frame(self, bg=PAGE_BG)
        body.pack(fill="both", expand=True, padx=12, pady=12)

        # ---------- left: exam list / scheduling / monitoring ----------
        self.left = card(body, C_RED, width=440)
        self.left.pack(side="left", fill="y", padx=(0, 12))
        self.left.pack_propagate(False)
        panel_title(self.left, "📅  Exams", C_RED)
        self.exam_tree = ttk.Treeview(self.left, columns=("Title", "Start", "End", "Status"), show="headings", height=4)
        for c, w in (("Title", 130), ("Start", 105), ("End", 105), ("Status", 75)):
            self.exam_tree.heading(c, text=c)
            self.exam_tree.column(c, width=w, anchor="center")
        for status, col in STATUS_COLORS.items():
            self.exam_tree.tag_configure(status, background=col)
        self.exam_tree.pack(fill="x", padx=14, pady=8)
        self.start_btn = HoverButton(self.left, "▶  Start Selected Exam", C_RED, pady=8, command=self.start_exam)
        self.start_btn.pack(padx=14, pady=(0, 8), fill="x")

        # staff-only widgets: a notebook with 'Schedule' and 'Live Monitor' tabs
        self.staff_frame = tk.Frame(self.left, bg="white")
        self.staff_frame.pack(fill="both", expand=True, padx=8, pady=(0, 8))
        nb = ttk.Notebook(self.staff_frame)
        nb.pack(fill="both", expand=True)
        sched_tab = tk.Frame(nb, bg="white")
        mon_tab = tk.Frame(nb, bg="white")
        nb.add(sched_tab, text="🗓 Schedule")
        nb.add(mon_tab, text="📡 Live Monitor")

        f = tk.Frame(sched_tab, bg="white")
        f.pack(fill="x", padx=8, pady=8)
        self.s_vars = {k: tk.StringVar() for k in ("title", "subject", "start", "end", "duration", "count",
                                                    "negative", "pass_pct")}
        self.s_vars["duration"].set("30")
        self.s_vars["count"].set("5")
        self.s_vars["negative"].set("0")
        self.s_vars["pass_pct"].set("50")
        self.s_vars["start"].set(now_str())
        self.shuffle_var = tk.BooleanVar(value=True)

        def lbl(text, r, c):
            tk.Label(f, text=text, bg="white", font=("Segoe UI", 9, "bold")).grid(row=r, column=c, sticky="w", pady=2)

        def ent(key, r, c, width=14, span=1):
            tk.Entry(f, textvariable=self.s_vars[key], width=width, relief="solid", bd=1).grid(
                row=r, column=c, columnspan=span, padx=(4, 10), pady=2, sticky="w")

        lbl("Title", 0, 0)
        ent("title", 0, 1, width=36, span=3)
        lbl("Subject", 1, 0)
        self.subject_combo = ttk.Combobox(f, textvariable=self.s_vars["subject"], state="readonly", width=13)
        self.subject_combo.grid(row=1, column=1, padx=(4, 10), pady=2, sticky="w")
        lbl("Minutes", 1, 2)
        ent("duration", 1, 3, width=8)
        lbl("Start", 2, 0)
        ent("start", 2, 1, width=16)
        lbl("End", 2, 2)
        ent("end", 2, 3, width=16)
        lbl("Questions", 3, 0)
        ent("count", 3, 1, width=8)
        lbl("Pass %", 3, 2)
        ent("pass_pct", 3, 3, width=8)
        lbl("Negative", 4, 0)
        ttk.Combobox(f, textvariable=self.s_vars["negative"], values=["0", "0.25", "0.33", "0.5", "1"],
                     width=6).grid(row=4, column=1, padx=(4, 10), pady=2, sticky="w")
        tk.Checkbutton(f, text="Shuffle", variable=self.shuffle_var, bg="white", activebackground="white",
                       font=("Segoe UI", 9, "bold")).grid(row=4, column=2, columnspan=2, sticky="w")
        tk.Label(sched_tab, text="Format YYYY-MM-DD HH:MM · End is optional · Negative = fraction of the marks\n"
                                 "deducted for a wrong MCQ/True-False answer (0 = none, 0.25 = ¼ mark).",
                 bg="white", fg="#868e96", font=("Segoe UI", 8), justify="left").pack(anchor="w", padx=8)
        HoverButton(sched_tab, "Schedule Exam", C_BLUE, pady=4, command=self.schedule).pack(padx=8, pady=(6, 2), fill="x")
        HoverButton(sched_tab, "🗑  Delete Selected Exam", C_RED, pady=4,
                    command=self.delete_exam).pack(padx=8, pady=(2, 8), fill="x")

        self.mon_tree = ttk.Treeview(mon_tab, columns=("Student", "Exam", "Done", "Left", "Warn"),
                                     show="headings", height=6)
        for c, w in (("Student", 80), ("Exam", 120), ("Done", 55), ("Left", 55), ("Warn", 45)):
            self.mon_tree.heading(c, text=c)
            self.mon_tree.column(c, width=w, anchor="center")
        self.mon_tree.pack(fill="x", padx=8, pady=8)
        style_tree(self.mon_tree, C_GREEN)
        tk.Label(mon_tab, text="Warn = times the student left the exam window.", bg="white", fg="#868e96",
                 font=("Segoe UI", 8)).pack(anchor="w", padx=8)

        # ---------- right: exam-taking area ----------
        self.right = card(body, C_RED)
        self.right.pack(side="left", fill="both", expand=True)
        bar = tk.Frame(self.right, bg=NAVY)
        bar.pack(fill="x")
        self.exam_title = tk.Label(bar, text="No exam in progress", bg=NAVY, fg="white", font=("Segoe UI", 13, "bold"),
                                   padx=14, pady=10)
        self.exam_title.pack(side="left")
        self.timer_label = tk.Label(bar, text="", bg=NAVY, fg=C_YELLOW, font=("Consolas", 18, "bold"), padx=14)
        self.timer_label.pack(side="right")

        # navigation buttons first (bottom) so they can never be cut off
        nav = tk.Frame(self.right, bg="white")
        nav.pack(side="bottom", fill="x", padx=16, pady=12)
        self.prev_btn = HoverButton(nav, "⬅ Previous", C_PURPLE, command=self.prev_q)
        self.next_btn = HoverButton(nav, "Next ➡", C_BLUE, command=self.next_q)
        self.submit_btn = HoverButton(nav, "✔ Submit Exam", C_GREEN, command=self.submit_clicked)
        self.prev_btn.pack(side="left")
        self.next_btn.pack(side="left", padx=8)
        self.submit_btn.pack(side="right")

        info = tk.Frame(self.right, bg="white")
        info.pack(fill="x", padx=16, pady=(10, 0))
        self.progress_label = tk.Label(info, text="", bg="white", fg=C_PURPLE, font=("Segoe UI", 10, "bold"))
        self.progress_label.pack(side="left")
        self.warn_label = tk.Label(info, text="", bg="white", fg=C_RED, font=("Segoe UI", 10, "bold"))
        self.warn_label.pack(side="right")
        self.progress = ttk.Progressbar(self.right, style="Exam.Horizontal.TProgressbar", maximum=100)
        self.progress.pack(fill="x", padx=16, pady=(4, 0))

        content = tk.Frame(self.right, bg="white")
        content.pack(fill="both", expand=True, padx=16, pady=8)
        # question navigator (right column)
        pal = tk.Frame(content, bg="white", width=210)
        pal.pack(side="right", fill="y", padx=(12, 0))
        pal.pack_propagate(False)
        tk.Label(pal, text="🧭  Question Navigator", bg=NAVY, fg="white", anchor="w", padx=8, pady=5,
                 font=("Segoe UI", 10, "bold")).pack(fill="x")
        self.pal_grid = tk.Frame(pal, bg="white")
        self.pal_grid.pack(fill="x", pady=6)
        legend = tk.Frame(pal, bg="white")
        legend.pack(fill="x", pady=4)
        for text, col in (("Answered", C_GREEN), ("Not answered", "#ced4da"), ("Flagged", C_ORANGE), ("Current", NAVY)):
            row = tk.Frame(legend, bg="white")
            row.pack(anchor="w")
            tk.Label(row, bg=col, width=2).pack(side="left", padx=(0, 6), pady=1)
            tk.Label(row, text=text, bg="white", fg="#495057", font=("Segoe UI", 8)).pack(side="left")

        # question area (left column)
        qcol = tk.Frame(content, bg="white")
        qcol.pack(side="left", fill="both", expand=True)
        self.q_label = tk.Label(qcol, text="Select an exam on the left and click Start.", bg="#fff8e1", fg="#212529",
                                font=("Segoe UI", 13), wraplength=520, justify="left", anchor="w", padx=14, pady=14)
        self.q_label.pack(fill="x", pady=(0, 10))
        self.q_label.bind("<Configure>", lambda e: self.q_label.config(wraplength=max(300, e.width - 30)))

        self.answer_var = tk.StringVar()
        self.options_frame = tk.Frame(qcol, bg="white")
        self.options_frame.pack(anchor="w", padx=10)
        self.desc_box = tk.Text(qcol, height=7, width=60, wrap="word", relief="solid", bd=1)
        self.desc_box.bind("<KeyRelease>", lambda e: self._on_answer())
        self.flag_var = tk.BooleanVar(value=False)
        self.flag_btn = tk.Checkbutton(qcol, text="🚩  Mark this question for review", variable=self.flag_var,
                                       bg="white", activebackground="white", fg=C_ORANGE, font=("Segoe UI", 10, "bold"),
                                       cursor="hand2", command=self.toggle_flag)
        self.flag_btn.pack(side="bottom", anchor="w", pady=6)
        self._set_nav_state(False)

    # ---------- screen lifecycle ----------
    def on_show(self):
        staff = self.controller.auth.has_role("admin", "teacher")
        if staff:
            self.staff_frame.pack(fill="both", expand=True, padx=8, pady=(0, 8))
        else:
            self.staff_frame.pack_forget()
        is_student = self.controller.auth.has_role("student")
        self.start_btn.config(state="normal" if is_student else "disabled",
                              text="▶  Start Selected Exam" if is_student else "Exams are taken by students")
        subjects = self.controller.qbank.subjects()
        self.subject_combo["values"] = subjects
        if self.s_vars["subject"].get() not in subjects:
            self.s_vars["subject"].set(subjects[0] if subjects else "")
        self.refresh_exams()
        self._monitor_tick()

    def go_back(self):
        if self.session and not self.session.finished:
            with self.controller.proctor_paused():
                messagebox.showwarning("Exam in Progress", "Please submit your exam before leaving this screen.")
            return
        if self.monitor_job:
            self.after_cancel(self.monitor_job)
            self.monitor_job = None
        super().go_back()

    def refresh_exams(self):
        previous = self.exam_tree.selection()
        for row in self.exam_tree.get_children():
            self.exam_tree.delete(row)
        username = self.controller.auth.current_user["username"] if self.controller.auth.has_role("student") else None
        for e in self.controller.exams.list_exams():
            status = self.controller.exams.status(e, username)
            self.exam_tree.insert("", "end", iid=str(e["id"]), tags=(status,),
                                  values=(e["title"], e["start_time"], e.get("end_time") or "—", status))
        children = self.exam_tree.get_children()
        if children:                      # keep the old selection, otherwise pre-select the first exam
            self.exam_tree.selection_set(previous[0] if previous and previous[0] in children else children[0])

    def _monitor_tick(self):
        if self.monitor_job:
            self.after_cancel(self.monitor_job)
            self.monitor_job = None
        if not self.controller.auth.has_role("admin", "teacher"):
            return
        for row in self.mon_tree.get_children():
            self.mon_tree.delete(row)
        for r in self.controller.exams.monitoring_rows():
            self.mon_tree.insert("", "end", values=r)
        zebra(self.mon_tree)
        self.monitor_job = self.after(2000, self._monitor_tick)

    def schedule(self):
        v = {k: x.get().strip() for k, x in self.s_vars.items()}
        try:
            self.controller.exams.schedule(v["title"], v["subject"], v["start"], v["duration"], v["count"],
                                           end_time=v["end"], negative=v["negative"] or 0,
                                           shuffle=self.shuffle_var.get(), pass_percent=v["pass_pct"] or 50)
            messagebox.showinfo("Success", "Exam scheduled.")
            self.refresh_exams()
        except ValueError as e:
            messagebox.showerror("Invalid Data", str(e))

    def delete_exam(self):
        sel = self.exam_tree.selection()
        if not sel:
            return messagebox.showwarning("No Selection", "Select an exam in the table first.")
        if not messagebox.askyesno("Confirm", "Delete the selected exam?\n(Stored results are kept.)"):
            return
        try:
            self.controller.exams.delete(int(sel[0]))
        except ValueError as e:
            return messagebox.showwarning("Cannot Delete", str(e))
        self.refresh_exams()

    # ---------- taking the exam ----------
    def _set_nav_state(self, on):
        st = "normal" if on else "disabled"
        for b in (self.prev_btn, self.next_btn, self.submit_btn, self.flag_btn):
            b.config(state=st)

    def _instructions(self, exam):
        neg = float(exam.get("negative_marking") or 0)
        neg_text = "none" if neg == 0 else f"{neg} of the question's marks is deducted for each wrong MCQ / True-False answer"
        return (f"{exam['title']}\nSubject: {exam['subject']}\n\n"
                f"•  Questions: up to {exam['num_questions']}\n"
                f"•  Duration: {exam['duration_min']} minutes\n"
                f"•  Pass mark: {exam.get('pass_percent', 50)}%\n"
                f"•  Negative marking: {neg_text}\n\n"
                f"RULES\n"
                f"•  The timer starts when you click Yes and cannot be paused.\n"
                f"•  The exam is submitted automatically when time runs out.\n"
                f"•  Leaving this window (Alt+Tab, other apps) gives a warning;\n"
                f"   {MAX_PROCTOR_WARNINGS} warnings submit your exam automatically.\n"
                f"•  Use the Question Navigator to jump between questions and\n"
                f"   mark questions for review.\n\n"
                f"Start the exam now?")

    def start_exam(self):
        sel = self.exam_tree.selection()
        if not sel:
            return messagebox.showwarning("No Selection", "Select an exam first.")
        if self.session and not self.session.finished:
            return
        exam = next(e for e in self.controller.exams.list_exams() if e["id"] == int(sel[0]))
        username = self.controller.auth.current_user["username"]
        status = self.controller.exams.status(exam, username)
        if status != "Live":
            reasons = {"Upcoming": f"This exam opens at {exam['start_time']}.",
                       "Closed": f"This exam closed at {exam.get('end_time')}.",
                       "Completed": "You have already submitted this exam."}
            return messagebox.showwarning("Cannot Start", reasons.get(status, "This exam is not available."))
        if not messagebox.askyesno("Exam Instructions", self._instructions(exam)):
            return
        try:
            self.session = self.controller.exams.start(exam, username)
        except ValueError as e:
            return messagebox.showwarning("Cannot Start", str(e))
        self.exam_title.config(text=exam["title"])
        self.warn_label.config(text="")
        self._set_nav_state(True)
        self.show_question()
        self._tick()

    def _save_current_answer(self):
        if not self.session:
            return
        q = self.session.current()
        if q["qtype"] == "Descriptive":
            self.session.answers[q["id"]] = self.desc_box.get("1.0", "end").strip()
        else:
            self.session.answers[q["id"]] = self.answer_var.get()

    def _on_answer(self):
        if self.session and not self.session.finished:
            self._save_current_answer()
            self._refresh_progress()
            self._build_palette()

    def _refresh_progress(self):
        s = self.session
        q = s.current()
        done = s.answered_count()
        self.progress_label.config(text=f"Question {s.index + 1} of {len(s.questions)}  ·  {q['marks']} mark(s)  ·  "
                                        f"{q['qtype']}  ·  {q['difficulty']}   |   Answered {done}/{len(s.questions)}")
        self.progress["value"] = done / len(s.questions) * 100

    def _build_palette(self):
        for w in self.pal_grid.winfo_children():
            w.destroy()
        s = self.session
        for i in range(len(s.questions)):
            if i == s.index:
                bg, fg = NAVY, "white"
            elif i in s.flagged:
                bg, fg = C_ORANGE, "white"
            elif s.is_answered(i):
                bg, fg = C_GREEN, "white"
            else:
                bg, fg = "#ced4da", "#212529"
            HoverButton(self.pal_grid, str(i + 1), bg, fg=fg, width=3, padx=2, pady=2,
                        font=("Segoe UI", 9, "bold"),
                        command=lambda i=i: self.goto(i)).grid(row=i // 5, column=i % 5, padx=2, pady=2)

    def show_question(self):
        s = self.session
        q = s.current()
        self._refresh_progress()
        self.flag_var.set(s.index in s.flagged)
        self.q_label.config(text=q["text"])
        for w in self.options_frame.winfo_children():
            w.destroy()
        self.desc_box.pack_forget()
        saved = s.answers.get(q["id"], "")
        if q["qtype"] == "Descriptive":
            self.desc_box.delete("1.0", "end")
            self.desc_box.insert("1.0", saved)
            self.desc_box.pack(padx=4, pady=6, anchor="w", fill="x")
        else:
            self.answer_var.set(saved)
            choices = ([("A", q["option_a"]), ("B", q["option_b"]), ("C", q["option_c"]), ("D", q["option_d"])]
                       if q["qtype"] == "MCQ" else [("True", "True"), ("False", "False")])
            palette = [C_BLUE, C_ORANGE, C_GREEN, C_PURPLE]
            for i, (value, label) in enumerate(choices):
                if label:
                    text = f"{value}.  {label}" if q["qtype"] == "MCQ" else label
                    tk.Radiobutton(self.options_frame, text=text, value=value, variable=self.answer_var,
                                   bg="white", fg=palette[i % 4], activeforeground=palette[i % 4],
                                   selectcolor="#fff3bf", font=("Segoe UI", 12, "bold"), anchor="w",
                                   cursor="hand2", command=self._on_answer).pack(anchor="w", pady=4)
        self._build_palette()

    def goto(self, index):
        self._save_current_answer()
        self.session.index = index
        self.show_question()

    def next_q(self):
        if self.session.index < len(self.session.questions) - 1:
            self.goto(self.session.index + 1)
        else:
            self.goto(self.session.index)

    def prev_q(self):
        if self.session.index > 0:
            self.goto(self.session.index - 1)
        else:
            self.goto(self.session.index)

    def toggle_flag(self):
        s = self.session
        if not s:
            return
        if self.flag_var.get():
            s.flagged.add(s.index)
        else:
            s.flagged.discard(s.index)
        self._build_palette()

    def _tick(self):
        s = self.session
        if not s or s.finished:
            return
        rem = s.remaining_seconds()
        self.timer_label.config(text=f"⏱ {fmt_secs(rem)}", fg="#ff6b6b" if rem <= 60 else C_YELLOW)
        if rem <= 0:
            with self.controller.proctor_paused():
                messagebox.showinfo("Time Up", "Time has expired. Your exam is being submitted automatically.")
            self.finish(auto=True)
            return
        self.timer_job = self.after(1000, self._tick)

    def proctor_violation(self):
        """Called by the app when the exam window lost focus."""
        s = self.session
        if not s or s.finished:
            return
        s.warnings += 1
        self.warn_label.config(text=f"⚠ Warnings: {s.warnings}/{MAX_PROCTOR_WARNINGS}")
        self.controller.audit.log("PROCTOR_WARNING", f"left the exam window ({s.warnings}/{MAX_PROCTOR_WARNINGS})",
                                  actor=s.username)
        with self.controller.proctor_paused():
            if s.warnings >= MAX_PROCTOR_WARNINGS:
                messagebox.showerror("Exam Terminated",
                                     "You left the exam window too many times.\nYour exam is being submitted now.")
            else:
                messagebox.showwarning("Warning", f"You left the exam window.\n\nWarning {s.warnings} of "
                                                  f"{MAX_PROCTOR_WARNINGS}. At {MAX_PROCTOR_WARNINGS} warnings your exam "
                                                  f"is submitted automatically.")
        if s.warnings >= MAX_PROCTOR_WARNINGS:
            self.finish(auto=True)

    def submit_clicked(self):
        self._save_current_answer()
        s = self.session
        unanswered = len(s.questions) - s.answered_count()
        msg = f"Submit your exam now?\n\nAnswered: {s.answered_count()} of {len(s.questions)}"
        if unanswered:
            msg += f"\n⚠ {unanswered} question(s) are unanswered."
        if s.flagged:
            msg += f"\n🚩 {len(s.flagged)} question(s) are marked for review."
        with self.controller.proctor_paused():
            ok = messagebox.askyesno("Confirm Submission", msg)
        if ok:
            self.finish(auto=False)

    def finish(self, auto):
        s = self.session
        if s.finished:
            return
        self._save_current_answer()
        s.finished = True
        if self.timer_job:
            self.after_cancel(self.timer_job)
            self.timer_job = None
        result = self.controller.results.evaluate_and_store(s, auto_submitted=auto)
        self.controller.exams.end(s.username)
        self._set_nav_state(False)
        self.timer_label.config(text="")
        self.exam_title.config(text="No exam in progress")
        self.progress_label.config(text="")
        self.warn_label.config(text="")
        self.progress["value"] = 0
        self.q_label.config(text="Exam submitted. Opening your result...")
        for w in self.options_frame.winfo_children():
            w.destroy()
        for w in self.pal_grid.winfo_children():
            w.destroy()
        self.desc_box.pack_forget()
        self.session = None
        self.controller.frames[ResultPage].focus_result = result["id"]
        self.controller.show_frame(ResultPage)


