def now_str():
    return datetime.now().strftime(DT_FMT)


def fmt_secs(seconds):
    seconds = max(0, int(seconds))
    return f"{seconds // 60:02d}:{seconds % 60:02d}"


def darken(hex_color, factor=0.82):
    r, g, b = (int(hex_color[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % (int(r * factor), int(g * factor), int(b * factor))


def blend(c1, c2, t):
    a = [int(c1[i:i + 2], 16) for i in (1, 3, 5)]
    b = [int(c2[i:i + 2], 16) for i in (1, 3, 5)]
    return "#%02x%02x%02x" % tuple(int(x + (y - x) * t) for x, y in zip(a, b))


class HoverButton(tk.Button):
    """Flat coloured button that darkens on hover."""

    def __init__(self, parent, text="", color=NAVY, **kw):
        kw.setdefault("fg", "white")
        kw.setdefault("relief", "flat")
        kw.setdefault("cursor", "hand2")
        kw.setdefault("font", ("Segoe UI", 10, "bold"))
        kw.setdefault("padx", 10)
        kw.setdefault("pady", 6)
        super().__init__(parent, text=text, bg=color, activebackground=darken(color),
                         activeforeground=kw["fg"], disabledforeground="#e9ecef", **kw)
        self.base = color
        self.bind("<Enter>", lambda e: self._hover(True))
        self.bind("<Leave>", lambda e: self._hover(False))

    def _hover(self, on):
        if str(self["state"]) != "disabled":
            self.config(bg=darken(self.base) if on else self.base)


