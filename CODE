        sb = ttk.Scrollbar(holder, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=sb.set)
        self.tree.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        for role, col in ROLE_COLORS.items():
            self.tree.tag_configure(role, background=blend("#ffffff", col, 0.15))

    def on_show(self):
        if not self.controller.require_role("admin"):
            self.after(10, self.go_back)
            return
        self.refresh()

    def refresh(self):
        for row in self.tree.get_children():
            self.tree.delete(row)
        for username, full_name, role, email, dept in self.controller.auth.list_users():
            self.tree.insert("", "end", iid=username, tags=(role,),
                             values=(username, full_name or "", role, email or "", dept or ""))

    def add_user(self):
        try:
            self.controller.auth.add_user(self.vars["username"].get(), self.vars["password"].get(),
                                          self.role_var.get(), self.vars["full_name"].get())
        except ValueError as e:
            return messagebox.showerror("Invalid Data", str(e))
        messagebox.showinfo("Success", f"User '{self.vars['username'].get().strip()}' added.")
        for v in self.vars.values():
            v.set("")
        self.refresh()

    def insert_example(self):
        self.bulk_box.delete("1.0", "end")
        self.bulk_box.insert("1.0", "stud101 | pass1234 | Anil Kumar\nstud102 | pass1234 | Priya Sharma\n"
                                    "stud103 | pass1234 | Rahul Verma\n")

    def bulk_add(self):
        text = self.bulk_box.get("1.0", "end")
        if not text.strip():
            return messagebox.showwarning("Nothing to add", "Paste at least one line first.")
        self.config(cursor="watch")
        self.update_idletasks()          # passwords are hashed securely, so large batches take a moment
        added, errors = self.controller.auth.bulk_add_users(text, self.bulk_role.get())
        self.config(cursor="")
        msg = f"✅ {added} user(s) added."
        if errors:
            msg += f"\n\n⚠ {len(errors)} line(s) skipped:\n" + "\n".join(errors[:10])
            if len(errors) > 10:
                msg += f"\n... and {len(errors) - 10} more"
        messagebox.showinfo("Bulk Add Users", msg)
        if added:
            self.bulk_box.delete("1.0", "end")
        self.refresh()

    def edit_user(self):
        sel = self.tree.selection()
        if len(sel) != 1:
            return messagebox.showwarning("Select One User", "Select exactly one user in the table first.")
        username = sel[0]
        row = next((u for u in self.controller.auth.list_users() if u[0] == username), None)
        if not row:
            return
        win = tk.Toplevel(self)
        win.title(f"Edit user: {username}")
        win.geometry("400x290")
        win.configure(bg="white")
        win.transient(self)
        tk.Label(win, text=f"✏️  Edit  @{username}", bg=C_BLUE, fg="white", anchor="w", padx=14, pady=10,
                 font=("Segoe UI", 13, "bold")).pack(fill="x")
        name_var, role_var, pw_var = tk.StringVar(value=row[1] or ""), tk.StringVar(value=row[2]), tk.StringVar()
        form = tk.Frame(win, bg="white")
        form.pack(fill="x", padx=20, pady=14)
        tk.Label(form, text="Full name", bg="white", font=("Segoe UI", 9, "bold")).grid(row=0, column=0, sticky="w", pady=4)
        tk.Entry(form, textvariable=name_var, width=28, relief="solid", bd=1).grid(row=0, column=1, pady=4)
        tk.Label(form, text="Role", bg="white", font=("Segoe UI", 9, "bold")).grid(row=1, column=0, sticky="w", pady=4)
        ttk.Combobox(form, textvariable=role_var, values=["student", "teacher", "admin"], state="readonly",
                     width=25).grid(row=1, column=1, pady=4)
        tk.Label(form, text="New password", bg="white", font=("Segoe UI", 9, "bold")).grid(row=2, column=0, sticky="w", pady=4)
        tk.Entry(form, textvariable=pw_var, show="*", width=28, relief="solid", bd=1).grid(row=2, column=1, pady=4)
        tk.Label(win, text="Leave 'New password' empty to keep the current password.", bg="white", fg="#868e96",
                 font=("Segoe UI", 8)).pack()

        def save():
            try:
                self.controller.auth.update_user(username, name_var.get(), role_var.get(), pw_var.get())
            except ValueError as e:
                return messagebox.showerror("Cannot Save", str(e), parent=win)
            messagebox.showinfo("Saved", "User updated.", parent=win)
            win.destroy()
            self.refresh()
        btns = tk.Frame(win, bg="white")
        btns.pack(pady=14)
        HoverButton(btns, "💾  Save", C_GREEN, command=save).pack(side="left", padx=6)
        HoverButton(btns, "Cancel", C_GRAY, command=win.destroy).pack(side="left", padx=6)

    def delete_users(self):
        names = list(self.tree.selection())
        if not names:
            return messagebox.showwarning("No Selection", "Select one or more users in the table first.")
        if not messagebox.askyesno("Confirm", f"Delete {len(names)} selected user(s)?"):
            return
        problems = []
        for name in names:
            try:
                self.controller.auth.delete_user(name)
            except ValueError as e:
                problems.append(f"{name}: {e}")
        if problems:
            messagebox.showwarning("Some users were not deleted", "\n".join(problems))
        self.refresh()


