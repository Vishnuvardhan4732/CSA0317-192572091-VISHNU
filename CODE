        container.pack(fill="both", expand=True)
        container.grid_rowconfigure(0, weight=1)
        container.grid_columnconfigure(0, weight=1)

        self.frames = {}
        for Page in (LoginPage, DashboardPage, QuestionBankPage, ExamPage, ResultPage,
                     AnalyticsPage, ProfilePage, UsersPage):
            frame = Page(parent=container, controller=self)
            self.frames[Page] = frame
            frame.grid(row=0, column=0, sticky="nsew")

        # session management: any activity resets the inactivity clock
        for ev in ("<Key>", "<Button>", "<Motion>"):
            self.bind_all(ev, lambda e: self.auth.touch(), add="+")
        self.after(5000, self._check_inactivity)

        # proctoring: detect the exam window losing focus (Alt+Tab, clicking another app ...)
        self._proctor_pause = 0
        self._away = False
        self._focus_check_pending = False
        self.bind("<FocusOut>", self._on_focus_out)
        self.bind("<FocusIn>", self._on_focus_in)

        self._tick_clock()
        self.show_frame(LoginPage)

    def _setup_styles(self):
        style = ttk.Style(self)
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass
        style.configure("Treeview", rowheight=28, font=("Segoe UI", 10), fieldbackground="white")
        style.configure("Treeview.Heading", background=NAVY, foreground="white",
                        font=("Segoe UI", 10, "bold"), relief="flat", padding=6)
        style.map("Treeview.Heading", background=[("active", C_BLUE)])
        style.map("Treeview", background=[("selected", C_YELLOW)], foreground=[("selected", "#212529")])
        style.configure("Exam.Horizontal.TProgressbar", troughcolor="#dee2e6", background=C_GREEN, thickness=14)
        style.configure("TNotebook", background="white", borderwidth=0)
        style.configure("TNotebook.Tab", padding=(14, 6), font=("Segoe UI", 10, "bold"), background="#dee2e6")
        style.map("TNotebook.Tab", background=[("selected", C_ORANGE)], foreground=[("selected", "white")])

    def show_frame(self, page_class):
        frame = self.frames[page_class]
        if hasattr(frame, "on_show"):
            frame.on_show()
        frame.tkraise()

    # ---------- status bar ----------
    def _tick_clock(self):
        user = self.auth.current_user
        who = f"👤 {user['full_name']}  ·  {user['role'].title()}" if user else "Not logged in"
        if self.exams.active:
            who += "   ·   🔴 EXAM IN PROGRESS"
        self.status_left.config(text=f"{APP_NAME} v{APP_VERSION}   |   {who}")
        self.status_right.config(text=datetime.now().strftime("%a %d %b %Y  %H:%M:%S"))
        self.after(1000, self._tick_clock)

    # ---------- session timeout ----------
    def _check_inactivity(self):
        exam_running = bool(self.exams.active)
        if self.auth.session_expired() and not exam_running:
            self.logout(reason="You were logged out after a period of inactivity.")
        self.after(5000, self._check_inactivity)

    def logout(self, reason=None):
        self.auth.logout()
        self.show_frame(LoginPage)
        if reason:
            messagebox.showinfo("Session Ended", reason)

    # ---------- proctoring ----------
    @contextmanager
    def proctor_paused(self):
        """Use around our own dialogs so they are not counted as 'leaving the exam'."""
        self._proctor_pause += 1
        try:
            yield
        finally:
            self.after(600, self._resume_proctor)

    def _resume_proctor(self):
        self._proctor_pause = max(0, self._proctor_pause - 1)

    def _on_focus_in(self, _event):
        self._away = False

    def _on_focus_out(self, _event):
        if self.exams.active and not self._proctor_pause and not self._focus_check_pending:
            self._focus_check_pending = True
            self.after(300, self._check_focus_lost)

    def _check_focus_lost(self):
        self._focus_check_pending = False
        if not self.exams.active or self._proctor_pause or self._away:
            return
        if self.focus_displayof() is None:           # the whole application lost focus
            self._away = True
            self.frames[ExamPage].proctor_violation()

    def _on_close(self):
        if self.exams.active and not messagebox.askyesno(
                "Exam in progress", "An exam is still running. Closing now will lose the attempt.\n\nClose anyway?"):
            return
        self.destroy()

    def require_role(self, *roles):
        if not self.auth.has_role(*roles):
            messagebox.showerror("Access Denied", "You do not have permission to open this module.")
            return False
        return True


